{
  "name": "@local/lumina-kitchen",
  "version": "3.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenzhongchao/lumina-kitchen.git"
  },
  "homepage": "https://github.com/shenzhongchao/lumina-kitchen",
  "type": "module",
  "description": "浏览摄影图谱与运镜演示，把画面想法变成图片或视频。",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "resources",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "bundle:data": "node scripts/bundle-data.mjs",
    "prepack": "npm run build && npm run bundle:data",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.3.0",
    "dsh": "0.2.2-rc.3"
  },
  "license": "MIT"
}
