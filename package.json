{
  "name": "@local/lumina-kitchen",
  "version": "3.2.1",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/shenzhongchao/lumina-kitchen.git" },
  "homepage": "https://github.com/shenzhongchao/lumina-kitchen",
  "type": "module",
  "description": "LUMINA 创作台：从摄影图谱填写想法、推荐并调整配料，在创作详情中生成图片或视频，保留每一版作品与设置，支持对照和继续创作。",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "resources",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "bundle:data": "node scripts/bundle-data.mjs",
    "prepack": "npm run build && npm run bundle:data",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT"
}
